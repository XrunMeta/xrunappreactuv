{
  "expo": {
    "name": "XRUN",
    "slug": "XRUN",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_xrun_round_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "oth-google-api-key"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "앱의 주요 기능에 카메라 권한이 필요합니다",
        "NSPhotoLibraryUsageDescription": "원활한 사용을 위해서 사진 권한이 필요합니다",
        "NSLocationWhenInUseUsageDescription": "앱의 주요 기능에 위치 권한이 필요합니다",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "run.xrun.xrunapps"
    },
    "android": {
      "package": "run.xrun.xrunapp",
      "googleServicesFile": "./google-services.json",
      "versionCode": 177,
      "versionName": "3.2.9",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "oth-google-api-key"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-camera",
      "expo-location"
    ],
    "extra": {
      "eas": {
        "projectId": "98780521-4749-4507-8e3a-62a2b3a80783"
      }
    }
  }
}
