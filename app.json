{
  "expo": {
    "name": "XRUN",
    "slug": "XRUN",
    "scheme": "xrun",
    "version": "4.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon_xrun_round_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon_xrun_round_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "config": {
        "googleMapsApiKey": "oth-google-api-key"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "서비스 지점 안내, AR 기능 사용을 위해 카메라 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "선택적으로, 사용자의 이미지를 업로드 하기 위해 사진 권한이 필요합니다.",
        "NSLocationWhenInUseUsageDescription": "사용자 주변의 가까운 매장이나 서비스 지점을 찾아서 안내하기 위해 위치 정보가 사용됩니다.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleTypeRole": "Editor",
            "CFBundleURLSchemes": [
              "xrungoApp",
              "run.xrun.xrunapps",
              "com.googleusercontent.apps.1003094533748-ht43iomt62g0h1dmiii3huav334pqiie",
              "com.googleusercontent.apps.1003094533748-2g87114p66dfq8v0f7imi67r9h5on6g4"
            ],
            "CFBundleURLName": "run.xrun.xrunapps"
          }
        ],
        "GIDClientID": "oth-client.googleusercontent.invalid"
      },
      "bundleIdentifier": "run.xrun.xrunapps",
      "associatedDomains": [
        "applinks:www.xrun.run"
      ],
      "appleAuthentication": {
        "teamId": "677WG96CUJ",
        "clientId": "run.xrun.xrunapps.signin",
        "keyId": "C8A3JJZJBA",
        "redirectUri": "https://oth-path-auth.example.invalid/oth-path"
      }
    },
    "android": {
      "package": "run.xrun.xrunapp",
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "versionCode": 202,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "oth-google-api-key"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-camera",
      "expo-location",
      "expo-web-browser",
      "expo-iap",
      [
        "expo-build-properties",
        {
          "ios": {
            "entitlements": {
              "com.apple.developer.applesignin": [
                "Default"
              ]
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "98780521-4749-4507-8e3a-62a2b3a80783"
      }
    }
  }
}
