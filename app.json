{
  "expo": {
    "name": "XRUN",
    "slug": "XRUN",
    "scheme": "xrun",
    "version": "4.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon_xrun_round_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon_xrun_round_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "config": {
        "googleMapsApiKey": "oth-google-api-key"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "앱의 주요 기능에 카메라 권한이 필요합니다",
        "NSPhotoLibraryUsageDescription": "원활한 사용을 위해서 사진 권한이 필요합니다",
        "NSLocationWhenInUseUsageDescription": "앱의 주요 기능에 위치 권한이 필요합니다",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleTypeRole": "Editor",
            "CFBundleURLSchemes": [
              "run.xrun.xrunapps",
              "com.googleusercontent.apps.1003094533748-ht43iomt62g0h1dmiii3huav334pqiie",
              "com.googleusercontent.apps.1003094533748-2g87114p66dfq8v0f7imi67r9h5on6g4"
            ]
          }
        ],
        "GIDClientID": "oth-client.googleusercontent.invalid"
      },
      "bundleIdentifier": "run.xrun.xrunapps"
    },
    "android": {
      "package": "run.xrun.xrunapp",
      "googleServicesFile": "./google-services.json",
      "versionCode": 202,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "oth-google-api-key"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-camera",
      "expo-location",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "98780521-4749-4507-8e3a-62a2b3a80783"
      }
    }
  }
}
