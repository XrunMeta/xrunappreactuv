# NODE_BINARY for Xcode script phases (EAS Build: minimal PATH, so add fallbacks)
NODE_BINARY="${NODE_BINARY:-$(command -v node 2>/dev/null || true)}"
[ -z "$NODE_BINARY" ] && [ -x "/usr/local/bin/node" ] && NODE_BINARY="/usr/local/bin/node"
[ -z "$NODE_BINARY" ] && [ -x "/opt/homebrew/bin/node" ] && NODE_BINARY="/opt/homebrew/bin/node"
export NODE_BINARY
